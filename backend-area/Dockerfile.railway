# Dockerfile optimisé pour Railway
FROM php:8.2-fpm-alpine

# Installation des dépendances système
RUN apk add --no-cache \
    git \
    curl \
    libpng-dev \
    oniguruma-dev \
    libxml2-dev \
    zip \
    unzip \
    libcurl \
    nginx \
    supervisor \
    mysql-client \
    nodejs \
    npm

# Installation des extensions PHP
RUN docker-php-ext-install pdo_mysql mbstring exif pcntl bcmath gd curl

# Installation de Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Configuration Nginx
RUN mkdir -p /run/nginx
COPY nginx.conf /etc/nginx/nginx.conf

# Configuration Supervisor
COPY supervisord.conf /etc/supervisord.conf

WORKDIR /var/www

# Copier les fichiers de dépendances
COPY composer.json composer.lock* ./
COPY package.json package-lock.json* ./

# Installation des dépendances PHP (sans dev)
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist

# Installation des dépendances Node
RUN npm install

# Copier le reste du code
COPY . .

# Générer l'autoloader optimisé
RUN composer dump-autoload --optimize --no-dev

# Build des assets si nécessaire
RUN if [ -f "vite.config.js" ]; then npm run build; fi

# Permissions
RUN chown -R www-data:www-data /var/www/storage /var/www/bootstrap/cache
RUN chmod -R 775 /var/www/storage /var/www/bootstrap/cache

# Créer un script de démarrage
COPY start.sh /start.sh
RUN chmod +x /start.sh

# Exposer le port (Railway utilise la variable PORT)
EXPOSE ${PORT:-8000}

# Démarrer avec le script
CMD ["/start.sh"]
