# Dockerfile optimisé pour Railway
FROM php:8.4-fpm-alpine

    # Installation des dépendances système
    RUN apk add --no-cache \
        git \
        curl \
        curl-dev \
        libpng-dev \
        oniguruma-dev \
        libxml2-dev \
        zip \
        unzip \
        nginx \
        supervisor \
        mysql-client \
        nodejs \
        npm

    # Installation des extensions PHP
    RUN docker-php-ext-install pdo_mysql mbstring exif pcntl bcmath gd curl

    # Installation de Composer
    COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Configuration Nginx
RUN mkdir -p /run/nginx
COPY nginx.conf /etc/nginx/nginx.conf

# Configuration PHP-FPM pour écouter sur TCP
RUN echo 'listen = 127.0.0.1:9000' > /usr/local/etc/php-fpm.d/zz-custom.conf && \
    echo 'listen.allowed_clients = 127.0.0.1' >> /usr/local/etc/php-fpm.d/zz-custom.conf

# Configuration Supervisor
COPY supervisord.conf /etc/supervisord.conf

WORKDIR /var/www

# Copier les fichiers de dépendances
COPY composer.json composer.lock* ./
COPY package.json package-lock.json* ./

# Installation des dépendances PHP (sans dev)
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist

# Installation des dépendances Node
RUN npm install

# Copier le reste du code
COPY . .

# Générer l'autoloader optimisé
RUN composer dump-autoload --optimize --no-dev

# Build des assets si nécessaire
RUN if [ -f "vite.config.js" ]; then npm run build; fi

# Rendre le script de démarrage exécutable
RUN chmod +x /var/www/start.sh

# Permissions (using nobody user for Alpine Linux)
RUN chown -R nobody:nobody /var/www/storage /var/www/bootstrap/cache
RUN chmod -R 775 /var/www/storage /var/www/bootstrap/cache

# Exposer le port (Railway utilise la variable PORT)
EXPOSE ${PORT:-8000}

# Démarrer avec le script
CMD ["/var/www/start.sh"]
